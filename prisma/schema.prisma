// Modelo de datos del MVP de captación de propietarios (Costa Brava).
// SQLite en local. Los "enums" se guardan como String y se tipan en /types
// para poder migrar a PostgreSQL sin fricción.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  name                String
  email               String
  phone               String?
  language            String    @default("es") // es | ca | en | fr | de | nl | it | pt
  preferredContact    String? // PHONE | WHATSAPP | EMAIL
  source              String    @default("WEB_FORM") // WEB_FORM | GOOGLE_ADS | META_ADS | SEO | PARTNERS | DEMO
  status              String    @default("NEW") // código de PipelineStage: NEW | STUDY_DONE | PENDING_CONTACT | CONTACTED | APPOINTMENT | PROPOSAL_SENT | CONVERTED | LOST (+ personalizados)
  timeline            String // NOW | M1_3 | M3_6 | M6_12 | LATER | INFO_ONLY
  situation           String // PRIMARY | SECOND_HOME | TOURIST | RENTED | INHERITED | EMPTY
  intent              String    @default("LOW") // HIGH | MEDIUM | LOW
  motivation          String? // RELOCATION | INHERITANCE | LIQUIDITY | UNUSED | LIFE_CHANGE | UPGRADE | OTHER
  motivationText      String?
  urgency             String? // HIGH | NORMAL | LOW
  agencyInterest      Boolean?
  appointmentInterest Boolean   @default(false)
  estimatedValue      Int?
  estimatedValueMin   Int?
  estimatedValueMax   Int?
  score               Int       @default(0)
  scoreTier           String    @default("LOW") // LOW | MEDIUM | HIGH | HOT
  scoreBreakdown      String    @default("[]") // JSON ScoreItem[]
  nextAction          String?
  qualifiedAt         DateTime?
  convertedAt         DateTime?
  lostReason          String?
  isDemo              Boolean   @default(false)
  agencyId            String?
  agency              Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  // Origen de la valoración guardada: DEMO_MODEL (formulario) o STUDY (estudio vender/alquilar)
  valuationSource     String    @default("DEMO_MODEL")
  // CRM comercial
  emailNormalized     String? // email en minúsculas, para evitar contactos duplicados
  phoneNormalized     String? // últimas 9 cifras del teléfono
  primaryInterest     String? // SELL | RENT | ADVICE | REPORT_ONLY
  contactWindow       String? // franja preferida: MORNING | AFTERNOON | EVENING | ANY
  lastContactAt       DateTime?
  nextActionAt        DateTime?
  partnerShareConsent Boolean   @default(false) // consentimiento para comunicar sus datos a un colaborador

  property      Property?
  consent       Consent?
  appointments  Appointment[]
  conversations Conversation[]
  events        Event[]
  notes         Note[]
  studies       Study[]
  requests      ServiceRequest[]
  assignments   PartnerAssignment[]
  revenues      Revenue[]

  @@index([status])
  @@index([createdAt])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([nextActionAt])
}

model Property {
  id            String  @id @default(cuid())
  leadId        String  @unique
  lead          Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  location      String // ROSES | EMPURIABRAVA | CADAQUES | LLANCA | CASTELLO | FIGUERES | OTHER
  locationOther String?
  type          String // APARTMENT | HOUSE | VILLA | LAND | COMMERCIAL | OTHER
  sqm           Int?
  bedrooms      Int?
  bathrooms     Int?
  terrace       Boolean @default(false)
  pool          Boolean @default(false)
  parking       Boolean @default(false)
  condition     String? // NEW | GOOD | TO_REFORM
}

model Consent {
  id               String   @id @default(cuid())
  leadId           String   @unique
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consentContact   Boolean
  consentMarketing Boolean
  consentTimestamp DateTime
  consentVersion   String
  consentText      String // Texto exacto aceptado (en el idioma mostrado)
  language         String
}

model Agency {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  name                String
  zones               String // CSV de Location
  email               String
  phone               String
  languages           String // CSV de idiomas
  propertyTypes       String // CSV de PropertyType
  status              String   @default("ACTIVE") // PROSPECT | ACTIVE | PAUSED | ENDED
  monthlyFee          Int      @default(0)
  pricePerAppointment Int      @default(0)
  // Colaborador (inmobiliaria u otro profesional) de ámbito nacional
  partnerType         String   @default("INMOBILIARIA") // INMOBILIARIA | ABOGADO | GESTOR | TASADOR | OTRO
  services            String   @default("") // CSV: SELL | RENT | ADVICE
  provinces           String   @default("") // CSV de códigos INE de provincia
  municipalities      String   @default("") // texto libre (municipios concretos)
  contactName         String?
  agreementTerms      String? // condiciones comerciales acordadas (texto)
  notes               String?

  leads        Lead[]
  appointments Appointment[]
  assignments  PartnerAssignment[]
  revenues     Revenue[]

  // Zona inmobiliarias (cuentas, CRM propio e inmuebles). Solo con crmAccess = true.
  crmAccess   Boolean @default(false)
  maxListings Int     @default(25) // inmuebles activos (borrador, revisión, publicado, reservado)
  maxUsers    Int     @default(3)

  users      AgencyUser[]
  listings   Listing[]
  contacts   AgencyContact[]
  activities AgencyActivity[]
  visits     AgencyVisit[]
}

model Appointment {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  channel     String   @default("PHONE") // PHONE | VIDEO | VISIT
  status      String   @default("BOOKED") // REQUESTED | BOOKED | COMPLETED | CANCELLED
  source      String   @default("WEB_FORM") // WEB_FORM | AGENT | ADMIN | SIMULATION
  notes       String?

  @@index([scheduledAt])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel   String   @default("WEB_CHAT") // WEB_CHAT | WHATSAPP_DEMO
  provider  String   @default("demo")
  state     String   @default("{}") // JSON ConversationState
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED
  extracted String   @default("{}") // JSON ExtractedData

  messages ConversationMessage[]
}

model ConversationMessage {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // agent | lead | system
  content        String
  meta           String? // JSON (quick replies, acción, etc.)
}

// Eventos de negocio (timeline/notificaciones) y de analítica (funnel).
model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String // LEAD_CREATED... (BUSINESS) | landing_view... (ANALYTICS)
  category  String // BUSINESS | ANALYTICS
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sessionId String?
  payload   String? // JSON

  @@index([category, type, createdAt])
}

// Métricas de campaña. En el MVP son SIEMPRE datos de simulación (isDemo).
model Campaign {
  id           String  @id @default(cuid())
  channel      String // GOOGLE_ADS | META_ADS | SEO | PARTNERS
  name         String
  periodLabel  String
  impressions  Int
  clicks       Int
  leads        Int
  spend        Int // euros
  appointments Int
  isDemo       Boolean @default(true)
}

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    String   @default("Admin demo")
  content   String
}

// Hipótesis de negocio configurables (CPL, conversiones...).
model Setting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Estudio «¿Te conviene vender o alquilar tu vivienda?»
// ---------------------------------------------------------------------------

model Study {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  // Hash del token de acceso (cookie httpOnly). El id solo no da acceso al estudio.
  tokenHash          String
  input              String // JSON StudyInput (datos aportados por el propietario)
  assumptions        String // JSON hipótesis del simulador (última versión guardada)
  result             String // JSON StudySnapshot (valoración, zona, fuentes)
  ccaaCode           String
  provinceCode       String
  municipalityCode   String?
  municipalityName   String
  postalCode         String
  propertyType       String
  sqm                Int
  saleEstimate       Int?
  rentEstimate       Int?
  confidence         String // HIGH | MEDIUM | LOW | VERY_LOW | NONE
  tensionedStatus    String // DECLARED | PARTIAL | EXPIRED | NOT_FOUND | UNKNOWN
  /// Nombre que el propietario quiere en la portada del informe PDF (opcional; solo para su informe).
  reportClientName   String?
  // Captación comercial (solo si el propietario lo solicita)
  valuationRequested Boolean          @default(false)
  commercialStatus   String           @default("NEW") // NEW | CONTACTED | VALUATION_SCHEDULED | VALUATION_DONE | NOT_INTERESTED
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  preferredContact   String?
  comments           String?
  consentContact     Boolean?
  consentMarketing   Boolean?
  consentTimestamp   DateTime?
  consentVersion     String?
  contactRequestedAt DateTime?
  leadId             String?
  lead               Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  requests           ServiceRequest[]

  @@index([createdAt])
  @@index([valuationRequested])
}

// Declaraciones oficiales de zonas de mercado residencial tensionado (Ley 12/2023),
// importadas de la página del Ministerio de Vivienda y Agenda Urbana.
model TensionedAreaDeclaration {
  id                 String    @id @default(cuid())
  importedAt         DateTime  @default(now())
  ccaa               String
  municipalitiesText String
  validFrom          DateTime?
  validTo            DateTime?
  resolution         String
  bulletin           String?
  sourceUrl          String
}

// Caché de respuestas de fuentes oficiales (INE, Catastro…), con fecha de consulta.
model OfficialDataCache {
  key       String   @id
  payload   String
  source    String
  fetchedAt DateTime @default(now())
}

// Referencias de mercado cargadas por el equipo con su fuente (p. ej. estadística notarial
// con licencia, valor tasado del Ministerio…). Nunca se inventan.
model MarketReference {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  municipalityCode String
  municipalityName String
  kind             String // SALE_M2 | RENT_M2
  dataType         String // OFFICIAL | CLOSED_TRANSACTIONS | ASKING_PRICES | APPRAISAL
  value            Float
  low              Float?
  high             Float?
  period           String // p. ej. "2025-T4"
  sourceName       String
  sourceUrl        String?
  notes            String?
}

// ---------------------------------------------------------------------------
// CRM comercial
// ---------------------------------------------------------------------------

// Estados comerciales configurables. Los códigos de los 8 iniciales son fijos (se usan en los
// indicadores); la etiqueta, el orden y la visibilidad se pueden cambiar y se pueden añadir otros.
model PipelineStage {
  code   String  @id
  label  String
  order  Int
  kind   String  @default("OPEN") // OPEN | WON | LOST
  active Boolean @default(true)
  system Boolean @default(false) // los iniciales no se pueden borrar
}

// Solicitud de un propietario (un contacto puede tener varias). Guarda los consentimientos de cada envío.
model ServiceRequest {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  leadId              String
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studyId             String?
  study               Study?   @relation(fields: [studyId], references: [id], onDelete: SetNull)
  interest            String // SELL | RENT | ADVICE | REPORT_ONLY
  serviceCode         String?
  contactChannel      String? // PHONE | WHATSAPP | EMAIL
  contactWindow       String? // MORNING | AFTERNOON | EVENING | ANY
  comments            String?
  consentContact      Boolean
  consentPartnerShare Boolean  @default(false)
  consentMarketing    Boolean  @default(false)
  consentVersion      String
  consentText         String
  source              String   @default("STUDY_FINAL") // STUDY_FINAL | ADMIN

  @@index([createdAt])
  @@index([leadId])
}

// Servicios ofrecidos. Sin precios inventados: priceType "TBD" hasta que se definan.
model Service {
  code        String  @id // SELL | RENT | ADVICE
  name        String
  summary     String
  scope       String // alcance del servicio
  conditions  String  @default("")
  priceType   String  @default("TBD") // TBD | FREE | FIXED | QUOTE | COMMISSION
  priceAmount Int? // euros (FIXED) o porcentaje x100 (COMMISSION)
  priceNote   String?
  active      Boolean @default(true)
  order       Int     @default(0)
}

// Oportunidad asignada a un colaborador (solo con consentimiento para comunicar datos).
model PartnerAssignment {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  serviceCode String?
  status      String    @default("ASSIGNED") // ASSIGNED | ACCEPTED | REJECTED | WON | LOST
  result      String?
  closedAt    DateTime?

  @@index([agencyId])
}

// Ingresos reales registrados a mano (nunca simulados).
model Revenue {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  date        DateTime
  amount      Int // euros
  serviceCode String?
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  description String

  @@index([date])
}

// ---------------------------------------------------------------------------
// Portal inmobiliario: inmuebles en venta y alquiler
// ---------------------------------------------------------------------------

// Inmueble publicado por FINCALIA360 (agencyId = null) o por una inmobiliaria colaboradora.
// Nunca se publica sin pasar las comprobaciones (datos, autorización del propietario, certificado
// energético). Los de inmobiliarias además los aprueba el administrador.
model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reference String   @unique // F360-XXXXXX
  slug      String
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  status    String   @default("DRAFT") // DRAFT | REVIEW | PUBLISHED | RESERVED | SOLD | RENTED | UNPUBLISHED | ARCHIVED
  operation String // SALE | RENT | TRANSFER (traspaso de negocio)
  category  String   @default("HOME") // HOME (vivienda o inmueble) | MOORING (amarre náutico) | BUSINESS (negocio en traspaso)

  title        String
  description  String @default("")
  propertyType String // PISO | ATICO | DUPLEX | ESTUDIO | CASA | CHALET | LOCAL | OFICINA | GARAJE | TERRENO | OTRO
  price        Int // euros (venta) o euros/mes (alquiler)
  communityFee Int? // euros/mes

  // Ubicación. La dirección exacta y la referencia catastral son privadas (no se muestran en la web).
  provinceCode String
  municipality String
  zone         String?
  postalCode   String?
  address      String?
  cadastralRef String?

  builtArea  Int?
  usefulArea Int?
  bedrooms   Int?
  bathrooms  Int?
  floor      String?
  yearBuilt  Int?
  condition  String? // NEW | GOOD | TO_REFORM
  features   String  @default("") // CSV (ver services/listings/catalog.ts)

  // Certificado energético
  energyRating      String? // A..G | IN_PROGRESS | EXEMPT
  energyConsumption Float? // kWh/m² año
  energyEmissions   Float? // kg CO2/m² año

  // Alquiler
  rentalType     String? // HABITUAL | SEASONAL
  depositMonths  Int?
  minTermMonths  Int?
  availableFrom  DateTime?
  rentConditions String? // gastos incluidos, mascotas, garantías…
  rentalRegistry String? // nº del Registro Único de Arrendamientos (alquiler de temporada)

  // Autorización y comprobaciones previas a la publicación
  authorizationType  String? // MANDATE_EXCLUSIVE | MANDATE_SHARED | OWNER_SIGNED
  authorizationDate  DateTime?
  authorizationDoc   String? // clave del documento privado
  checkData          Boolean   @default(false)
  checkAuthorization Boolean   @default(false)
  checkEnergy        Boolean   @default(false)
  checkLegalRent     Boolean   @default(false) // alquiler: normativa revisada (zona tensionada, fianza…)

  // Amarres náuticos (category = MOORING). Medidas en metros.
  portName      String? // puerto deportivo o instalación náutica
  berthLength   Float? // longitud del amarre (o de la plaza de garaje)
  berthWidth    Float? // anchura del amarre (o de la plaza de garaje)
  maxBoatLength Float? // eslora máxima admitida
  maxBoatBeam   Float? // manga máxima admitida
  berthDepth    Float? // calado
  mooringType   String? // PONTOON | FINGER | DOCK | BUOY | DRY_STACK | OTHER
  rentPeriod    String? // DAY | WEEK | MONTH | SEASON | YEAR (alquiler de amarre)
  concessionEnd Int? // año de fin de la concesión o del derecho de uso
  extraInfo     String? // información adicional para el comprador o arrendatario

  // Locales, oficinas y terrenos
  // Negocios en traspaso (category = BUSINESS, operation = TRANSFER): price es el precio del traspaso
  premisesRent       Int? // alquiler mensual del local (euros/mes), si lo indica el anunciante
  distribution       String? // distribución (locales y oficinas)
  landClassification String? // URBAN | DEVELOPABLE | RUSTIC (solo si está verificada)
  landUse            String? // RESIDENTIAL | INDUSTRIAL | COMMERCIAL | AGRICULTURAL | MIXED | OTHER

  // SEO (lo edita el administrador; la IA solo propone)
  seoTitle       String? // título para Google (meta title)
  seoDescription String? // descripción para Google (meta description)
  slugText       String? // texto de la dirección: /inmueble/<slugText>-<referencia>

  // Traducciones del título y los textos del anuncio (catalán, inglés, alemán, francés), en JSON.
  // Las prepara la IA y el administrador puede revisarlas; se descartan si cambia el texto en español.
  translations String?

  ownerContactId String? // propietario en el CRM de la inmobiliaria
  ownerContact   AgencyContact? @relation("ListingOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)

  reviewRequestedAt DateTime?
  reviewNote        String? // motivo de devolución del administrador
  publishedAt       DateTime?
  publishedBy       String?

  photos    ListingPhoto[]
  inquiries ListingInquiry[]
  visits    AgencyVisit[]

  @@index([status, operation])
  @@index([category, status])
  @@index([agencyId])
}

model ListingPhoto {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  key       String   @unique // archivo en el almacenamiento (versión grande); la miniatura añade «-thumb»
  width     Int
  height    Int
  position  Int      @default(0)
  isMain    Boolean  @default(false)
  alt       String?

  @@index([listingId])
}

// Solicitud de información o visita desde la ficha pública.
model ListingInquiry {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  listingId      String
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agencyId       String? // copia del anunciante en el momento de la solicitud
  name           String
  email          String
  phone          String?
  message        String?
  wantsVisit     Boolean        @default(false)
  consentVersion String
  consentText    String
  status         String         @default("NEW") // NEW | HANDLED | DISCARDED
  contactId      String? // contacto creado en el CRM de la inmobiliaria
  contact        AgencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([agencyId, createdAt])
}

// ---------------------------------------------------------------------------
// Zona inmobiliarias: cuentas, sesiones y CRM propio de cada inmobiliaria
// ---------------------------------------------------------------------------

model AgencyUser {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String    @unique
  name         String
  role         String    @default("AGENT") // OWNER | AGENT
  status       String    @default("INVITED") // INVITED | ACTIVE | DISABLED
  passwordHash String?
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  sessions AgencySession[]
  tokens   AuthToken[]
}

// Sesión de la Zona inmobiliarias. Se guarda solo el hash del token (revocable desde el panel).
model AgencySession {
  id        String     @id // sha256 del token de la cookie
  createdAt DateTime   @default(now())
  expiresAt DateTime
  userId    String
  user      AgencyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Enlaces de un solo uso: invitación (activar la cuenta) y recuperación de contraseña.
model AuthToken {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      AgencyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // INVITE | RESET
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime?
}

// Contacto del CRM de una inmobiliaria (propietario, comprador, inquilino…). Siempre con agencyId.
model AgencyContact {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agencyId        String
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  kind            String // OWNER_SELL | OWNER_RENT | BUYER | TENANT | OTHER
  name            String
  email           String?
  phone           String?
  emailNormalized String?
  phoneNormalized String?
  status          String    @default("NEW") // NEW | PENDING_CONTACT | CONTACTED | VISIT_SCHEDULED | PROPOSAL_SENT | NEGOTIATION | WON | LOST
  source          String    @default("MANUAL") // MANUAL | PORTAL | FINCALIA360
  sourceRef       String? // id de la asignación o de la solicitud de origen
  notes           String?
  nextAction      String?
  nextActionAt    DateTime?
  lastContactAt   DateTime?
  createdById     String?

  activities AgencyActivity[]
  visits     AgencyVisit[]
  inquiries  ListingInquiry[]
  listings   Listing[]        @relation("ListingOwner")

  @@index([agencyId, status])
  @@index([agencyId, nextActionAt])
}

model AgencyActivity {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  at        DateTime      @default(now())
  agencyId  String
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId String
  contact   AgencyContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String // NOTE | CALL | EMAIL | WHATSAPP | MEETING | STATUS | SYSTEM
  summary   String
  userId    String?
  userName  String?

  @@index([contactId, at])
}

model AgencyVisit {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  agencyId  String
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId String
  contact   AgencyContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  at        DateTime
  status    String        @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  notes     String?

  @@index([agencyId, at])
}

// Registro de acciones sensibles (publicaciones, cuentas, exportaciones).
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorType String // ADMIN | AGENCY_USER | SYSTEM | PUBLIC
  actorId   String?
  agencyId  String?
  action    String
  entity    String
  entityId  String?
  detail    String?

  @@index([agencyId, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Comparables de alquiler registrados por el equipo (anuncios consultados a mano, con enlace y fecha).
// Son PRECIOS ANUNCIADOS, no rentas de contratos firmados. Se muestran en el informe con su fuente.
// ---------------------------------------------------------------------------
model RentComparable {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  provinceCode     String
  municipalityCode String? // código INE (5 cifras) si se conoce
  municipalityName String
  zone             String?
  propertyKind     String? // PISO | ATICO | DUPLEX | ESTUDIO | CASA_ADOSADA | CASA_INDEPENDIENTE | VILLA
  monthlyRent      Int // € al mes anunciados
  builtArea        Int? // m² construidos
  usefulArea       Int? // m² útiles
  bedrooms         Int?
  bathrooms        Int?
  furnished        Boolean?
  features         String? // texto libre: ascensor, terraza, garaje…
  sourceName       String // portal o fuente (p. ej. «Idealista», «Fotocasa», «anuncio en inmobiliaria»)
  url              String?
  observedAt       DateTime // fecha de consulta del anuncio
  notes            String?
  createdBy        String?

  @@index([municipalityCode, observedAt])
  @@index([provinceCode])
}

// Solicitudes gratuitas de publicación enviadas por propietarios («Publica tu vivienda gratis»).
// Llegan al administrador, que las revisa y, si procede, crea el anuncio. Las fotos son privadas.
model PublicationRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("NEW") // NEW | IN_REVIEW | CONVERTED | REJECTED

  // Propietario
  name  String
  email String
  phone String?

  // Inmueble
  category     String  @default("HOME") // HOME | MOORING
  operation    String // SALE | RENT
  propertyType String
  provinceCode String
  municipality String
  zone         String?
  address      String? // privada
  price        Int?
  builtArea    Int?
  bedrooms     Int?
  bathrooms    Int?
  portName     String?
  berthLength  Float?
  berthWidth   Float?
  premisesRent Int? // traspasos: alquiler mensual del local
  title        String? // traspasos: nombre del negocio indicado por el anunciante
  description  String  @default("")
  photos       String  @default("") // CSV de claves privadas (private/requests/…)

  // Consentimientos (texto y versión aceptados)
  isOwnerConfirmed Boolean  @default(false)
  privacyAccepted  Boolean  @default(false)
  consentVersion   String
  consentText      String
  marketingConsent Boolean  @default(false)

  adminNote String?
  listingId String? // anuncio creado a partir de la solicitud

  @@index([status, createdAt])
}

// Uso de la IA de redacción de anuncios (control de límites y costes).
model AiUsage {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  kind         String // LISTING_COPY | LISTING_TITLE | LISTING_DESCRIPTION
  adminId      String?
  listingId    String?
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  ok           Boolean  @default(true)
  error        String?

  @@index([createdAt])
}

// Mensajes del formulario de contacto de la web.
model ContactMessage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  status         String   @default("NEW") // NEW | HANDLED | DISCARDED
  name           String
  email          String
  phone          String?
  subject        String?
  message        String
  consentVersion String
  consentText    String

  @@index([status, createdAt])
}

// «Busco piso»: personas que buscan vivienda en compra o alquiler (Cataluña). Llegan como
// PENDING y solo se ven en la web cuando el administrador las publica (sin datos de contacto).
model SearchRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reference String   @unique // BP-XXXXXX (identificador público, no personal)
  status    String   @default("PENDING") // PENDING | PUBLISHED | HIDDEN | REJECTED | RESOLVED

  operation      String // SALE | RENT
  propertyType   String // PISO | ATICO | CASA_CHALET | ADOSADA | ESTUDIO | TERRENO | LOCAL | GARAJE | OTRO
  provinceCode   String
  municipalities String // nombres separados por «|»
  zone           String?
  minPrice       Int? // euros (compra) o euros/mes (alquiler)
  maxPrice       Int
  minBedrooms    Int?
  minBathrooms   Int?
  minArea        Int?
  maxArea        Int?
  terrace        String  @default("ANY") // YES | NO | ANY
  elevator       String  @default("ANY")
  parking        String  @default("ANY")
  exterior       String  @default("ANY")
  condition      String  @default("ANY") // NEW | GOOD | TO_REFORM | ANY
  description    String  @default("") // texto original (privado)
  publicText     String? // texto que se publica, revisado por el administrador

  // Contacto (privado: solo en el panel)
  name  String
  email String
  phone String?
  lang  String @default("es")

  // Consentimientos (texto y versión aceptados)
  privacyAccepted  Boolean @default(false)
  consentVersion   String
  consentText      String
  marketingConsent Boolean @default(false)

  adminNote   String?
  publishedAt DateTime?
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([status, operation, provinceCode])
}

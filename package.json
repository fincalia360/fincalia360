{
  "name": "captacion-costa-brava",
  "version": "0.1.0",
  "private": true,
  "description": "FINCALIA360: estudio para propietarios (valor estimado, alquiler legal y vender/alquilar/mantener).",
  "scripts": {
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-db.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:studio": "prisma studio",
    "prestart": "node scripts/ensure-db.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@prisma/client": "^6.16.0",
    "lucide-react": "^1.53.0",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.4.49",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "engines": {
    "node": ">=20.11"
  }
}

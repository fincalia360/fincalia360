# Base de datos local (SQLite). Ruta relativa a prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Panel de administración (/admin) ---------------------------------------
# Sin ADMIN_PASSWORD el panel solo es accesible en desarrollo (npm run dev).
# En producción es OBLIGATORIO definir ADMIN_PASSWORD y ADMIN_SESSION_SECRET.
ADMIN_USER="admin"
ADMIN_PASSWORD=""
# Cadena aleatoria larga (p. ej. `openssl rand -base64 32`)
ADMIN_SESSION_SECRET=""

# --- Agente conversacional ---------------------------------------------------
# demo | openai | anthropic (openai/anthropic son adapters preparados; si fallan, fallback a demo)
AI_PROVIDER="demo"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Asistente virtual del estudio (Claude). Sin ANTHROPIC_API_KEY el chat no se muestra.
ANTHROPIC_MODEL="claude-haiku-5-5"
# Límite diario de mensajes al asistente (control de coste)
CHAT_DAILY_MESSAGE_LIMIT="500"

# --- Correo (Resend: https://resend.com) ---------------------------------------
# Sin RESEND_API_KEY y EMAIL_FROM no se envía ningún correo: el panel lo indica (no se simula).
RESEND_API_KEY=""
# Remitente verificado en Resend, p. ej. "FINCALIA360 <hola@fincalia360.es>"
EMAIL_FROM=""
# Correo del equipo que recibe el aviso de cada solicitud
TEAM_NOTIFICATION_EMAIL=""

# --- Estudio «vender o alquilar» ---------------------------------------------
# Datos de EJEMPLO (€/m² ficticios) cuando no hay ninguna fuente para el valor de venta.
# Solo para demostraciones: en producción debe ser "false".
STUDY_EXAMPLE_DATA="false"
# Carpeta con los JSON de SERPAVI (por defecto ./data/serpavi)
SERPAVI_DATA_DIR=""
# Comparables de Idealista (requiere solicitud de acceso y aceptación de sus condiciones)
IDEALISTA_API_KEY=""
IDEALISTA_API_SECRET=""

# --- Publicación (producción) ------------------------------------------------
# En el servidor: SEED_DEMO_DATA=false para que la base de datos se cree vacía (sin datos de demostración).
SEED_DEMO_DATA=""
# Dirección pública de la web (p. ej. https://www.fincalia360.es) y permiso para buscadores
SITE_URL=""
ALLOW_INDEXING="false"

# --- Datos del titular para los textos legales (aviso legal, privacidad) -----
LEGAL_OWNER_NAME=""
LEGAL_OWNER_NIF=""
LEGAL_OWNER_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_OWNER_REGISTRY=""
LEGAL_HOSTING_PROVIDER=""
